# Copie para .env (desenvolvimento). Em produção, defina estas variáveis na Vercel.
DEBUG=True
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Vazio = SQLite local. Produção (PostgreSQL): postgres://usuario:senha@host:5432/banco
DATABASE_URL=

# Outro arquivo de ambiente (ex.: .env.local gerado por `vercel pull`) para rodar migrations em produção:
# $env:ENV_FILE=".env.local"
